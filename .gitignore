# ============================================
# .gitignore untuk yelp-business-explorer
# Monorepo: NPM Workspaces (Express + MySQL + Vite/React)
# ============================================

# ---------- Dependensi ----------
node_modules/
jspm_packages/
web_modules/
.pnpm-store/

# ---------- Output Build (Vite & Express) ----------
# Vite menggunakan `dist`, Express mungkin menggunakan `build` atau `dist`
dist/
build/
out/
.gh-pages/
*.tsbuildinfo

# ---------- Backend Spesifik (Express + MySQL) ----------
# Abaikan file database lokal jika ada
*.sqlite
*.sqlite3
*.db
# Abaikan folder unggahan jika backend menangani upload file
uploads/

# ---------- Testing & Coverage ----------
coverage/
.nyc_output/
junit.xml
test-results/
playwright-report/
cypress/videos/
cypress/screenshots/

# ---------- Cache ----------
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.npm/
.node_repl_history
.jest-cache/
node_modules/.cache/
.temp/
.tmp/

# ---------- Environment Variables & Secrets ----------
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
*.pem
*.key

# ---------- Deployment Platforms ----------
.vercel
.netlify

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
bun-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ---------- Editors & IDEs ----------
# JetBrains
.idea/
*.iml
*.ipr
*.iws
# VS Code (simpan pengaturan bersama)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.code-workspace
# Vim / Emacs / misc
*.swp
*.swo
*~
\#*\#
.\#*

# ---------- OS Generated Files ----------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# Linux
.directory
.Trash-*

# ---------- Lockfile Manajer Paket ----------
# Proyek ini menggunakan NPM Workspaces. Commit package-lock.json di root.
# Namun, frontend memiliki bun.lock. Sebaiknya konsisten menggunakan satu manajer paket.
# Untuk saat ini, abaikan lockfile lain agar tidak membingungkan.
# yarn.lock
# pnpm-lock.yaml
# (Catatan: package-lock.json TIDAK diabaikan karena proyek menggunakan NPM Workspaces)
